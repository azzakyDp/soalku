# Export these variables in your shell or configure them in the deployment runtime.
# Spring Boot does not automatically load a .env file.
# On Windows, run .\scripts\Import-SoalKuEnv.ps1 in the application shell.
# Supabase session pooler: jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/soalku
DB_USERNAME=soalku
DB_PASSWORD=replace-with-your-database-password

# Base64 encoding of at least 32 cryptographically random bytes; no default key.
JWT_SECRET=replace-with-a-generated-base64-secret
JWT_ISSUER=soalku
JWT_TTL=15m
MATERIAL_STORAGE_ROOT=./data/materials

# Set locally; never commit a real Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=20s
GEMINI_QUESTIONS_PER_SECTION=5

# Session deadline: this budget multiplied by the actual selected question count (1–600).
LATIHAN_SECONDS_PER_QUESTION=60
